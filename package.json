{
  "name": "app-visium",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:docker": "vite --host --port 3000",
    "build": "tsc && vite build",
    "build:docker": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "prepare": "husky install",
    "release:patch": "git add . && standard-version -a --no-verify --release-as patch",
    "release:minor": "git add . && standard-version -a --no-verify --release-as minor",
    "release:major": "git add . && standard-version -a --no-verify --release-as major",
    "release:dry": "git add . && standard-version -a --dry-run --no-verify",
    "docker:local:dev": "docker image prune -f && docker-compose down && docker-compose up --build --remove-orphans",
    "docker:local:staging": "docker image prune -f && docker-compose down && docker-compose -f ./docker-compose.staging.yml up --build --remove-orphans"
  },
  "dependencies": {
    "@tanstack/react-query": "^4.33.0",
    "i18next": "^23.4.5",
    "localforage": "^1.10.0",
    "match-sorter": "^6.3.1",
    "moment": "^2.29.4",
    "normalize.css": "^8.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^13.2.0",
    "react-router-dom": "^6.15.0",
    "sort-by": "^1.2.0"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "^4.32.5",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.3",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "husky": "^8.0.3",
    "standard-version": "^9.5.0",
    "typescript": "^5.0.2",
    "vite": "^4.4.5"
  }
}
